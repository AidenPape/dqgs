# 56-dim (atm 2x4) MAOOAM Brajard 30,000-year spin-up, RESUMED from the most recent
# checkpoint (test_ideas/spinup56_brajard_ckpt.npz). Runs on GPU (integrate_final only,
# no linalg.solve). Checkpoints every 10M steps; walltime caps at 12 h.

module load conda
conda activate /glade/work/wchapman/conda-envs/run_graphcast
export PYTHONPATH=/glade/u/home/wchapman/help_aiden
cd /glade/u/home/wchapman/help_aiden

echo "==== device check ===="
python -u -c "import jax; print('JAX DEVICES:', jax.devices())"
echo "======================"

python -u test_ideas/spinup56_brajard.py
