# Agent instructions stay out of the repo.
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# macOS
.DS_Store

# Generated results: figures are tracked because the manuscript needs them,
# but the arrays and job logs they come from are not, except the 16000- and
# 32000-step sectioned-loss runs, which move between machines by git. Smoke-test
# outputs match those names and stay untracked.
error_discovery/results/data/*
error_discovery/results/logs/*
!error_discovery/results/data/*_window_16000_steps.npz
!error_discovery/results/data/*_window_32000_steps.npz
!error_discovery/results/logs/*_window_16000_steps.log
!error_discovery/results/logs/*_window_32000_steps.log
error_discovery/results/data/*smoke*
error_discovery/results/logs/*smoke*
scratch/*.npz
scratch/*.log

# Spun-up states are tracked; spin_up's in-progress checkpoints are not.
error_discovery/initial_conditions/*.partial.npz
error_discovery/initial_conditions/*.tmp.npz
